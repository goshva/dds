# Superset base URL (no trailing slash)
SUPERSET_URL=https://superset.svc.vkusvill.ru

# Use a dedicated account with read-only access where possible.
SUPERSET_USERNAME=
SUPERSET_PASSWORD=
SUPERSET_PROVIDER=db

# Optional: use a pre-existing JWT if your organization provides one.
SUPERSET_ACCESS_TOKEN=

# Request controls
HTTP_TIMEOUT_SECONDS=30
PAGE_SIZE=100
MAX_PAGES=50
OUTPUT_DIR=./output
SQL_EXECUTION_ENABLED=false

# Local metadata catalog
SQLITE_PATH=./data/catalog.sqlite

# Discovery keywords: tune after reviewing actual dashboard/dataset names.
COURIER_KEYWORDS=courier,курьер,доставка,delivery,доставк,курьерск,shipment,rider,driver,логист
EXCLUDE_KEYWORDS=sku,артикул,ассортимент,товар,product,товарная,корзин
