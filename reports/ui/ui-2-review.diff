@@ -0,0 +1,57 @@
+/** UI-2: Hono-приложение DSS (read-only API, локальный bind). */
+import { Hono } from "hono";
+
+import { toErrorResponse } from "./api";
+import { apiRoutes } from "./routes";
+
+/**
+ * UI-2.1: защита локального API без авторизации.
+ *  - Host allowlist: отсекает DNS rebinding и обращения по чужому имени;
+ *  - Origin allowlist: разрешает same-origin и Vite dev server, отклоняет посторонние страницы.
+ */
+const ALLOWED_HOSTS = new Set(["127.0.0.1", "localhost", "[::1]", "::1"]);
+const ALLOWED_ORIGINS = new Set(["http://127.0.0.1:5173", "http://localhost:5173"]);
+
+function hostAllowed(rawHost: string | undefined): boolean {
+  // Реальный HTTP/1.1 всегда передаёт Host; отсутствие заголовка возможно только
+  // при внутреннем вызове app.request() (тесты), поэтому не блокируем его.
+  if (!rawHost) return true;
+  const host = rawHost.trim().toLowerCase();
+  const name = host.startsWith("[") ? host.slice(0, host.indexOf("]") + 1) : host.split(":")[0]!;
+  return ALLOWED_HOSTS.has(name);
+}
+
+function originAllowed(rawOrigin: string | undefined): boolean {
+  if (!rawOrigin) return true;
+  const origin = rawOrigin.trim().replace(/\/$/, "").toLowerCase();
+  if (ALLOWED_ORIGINS.has(origin)) return true;
+  return ALLOWED_HOSTS.has(new URL(origin.startsWith("http") ? origin : `http://${origin}`).hostname);
+}
+export function createApp() {
+  const app = new Hono();
+  app.use("*", async (context, next) => {
+    await next();
+    context.header("Cache-Control", "no-store");
+    context.header("X-Content-Type-Options", "nosniff");
+    context.header("Referrer-Policy", "no-referrer");
+  });
+  app.use("/api/*", async (context, next) => {
+    if (!hostAllowed(context.req.header("host"))) {
+      return context.json({ status: "error", error: { code: "HOST_NOT_ALLOWED", message: "Host is not allowed" } }, 403);
+    }
+    if (!originAllowed(context.req.header("origin"))) {
+      return context.json({ status: "error", error: { code: "ORIGIN_NOT_ALLOWED", message: "Origin is not allowed" } }, 403);
+    }
+    await next();
+  });
+  app.route("/", apiRoutes);
+  app.notFound((context) => context.json({ status: "error", error: { code: "NOT_FOUND", message: "Endpoint not found" } }, 404));
+  app.onError((error, context) => {
+    const response = toErrorResponse(error);
+    console.error(`[dss-api] ${response.body.error.code}: ${error instanceof Error ? error.message : "unknown"}`);
+    return context.json(response.body, response.status as 500);
+  });
+  return app;
+}
+
+export const app = createApp();
