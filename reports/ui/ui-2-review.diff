+/** UI-2: read-only доступ к источникам DSS (CSV/JSONL); записи не выполняются. */
+import { readFile } from "node:fs/promises";
+import { resolve } from "node:path";
+
+import { readCanonicalCsv } from "../forecasting/analytics/expansion/history-builder";
+import {
+  isReconciliationRecord,
+  isShadowErrorRecord,
+  isSnapshotRecord,
+  readJsonl,
+  storePaths,
+  type ReconciliationRecord,
+  type ShadowError,
+  type ShadowManifest,
+  type ShadowSnapshot,
+} from "../forecasting/shadow/store";
+import { SourceError } from "./api";
+
+export const CANONICAL_CSV = "data/processed/forecasting/7745/canonical_daily_delivered_orders.csv";
+export const SHADOW_DIR = "data/shadow/7745";
+export const SHOP_NO = "7745";
+export const SLICE_ID = 20624;
+export const TARGET_METRIC = "qty_orders_delivered";
+export const TIMEZONE = "Europe/Moscow";
+
+export interface HistoryPoint { date: string; value: number }
+const ISO_DATE = /^\d{4}-\d{2}-\d{2}$/;
+
+function checksum(text: string): string {
+  return new Bun.CryptoHasher("sha256").update(text).digest("hex");
+}
+function shadowPaths() {
+  return storePaths(resolve(SHADOW_DIR));
+}
+
+export async function readHistory(): Promise<{ points: HistoryPoint[]; checksum: string }> {
+  const path = resolve(CANONICAL_CSV);
+  let text: string;
+  try {
+    text = await readFile(path, "utf8");
+  } catch {
+    throw new SourceError("SOURCE_NOT_AVAILABLE", "Canonical dataset is not available");
+  }
+  const lines = text.trim().split(/\r?\n/);
+  if (lines.length < 2) throw new SourceError("DATA_SOURCE_CORRUPTED", "Canonical dataset is empty");
+  const header = lines[0]!.split(",");
+  for (const column of ["date", "shop_no", "metric", "value"]) {
+    if (!header.includes(column)) throw new SourceError("DATA_SOURCE_CORRUPTED", "Canonical dataset header is invalid");
+  }
+  let points: HistoryPoint[];
+  try {
+    points = await readCanonicalCsv(path);
+  } catch {
+    throw new SourceError("DATA_SOURCE_CORRUPTED", "Canonical dataset cannot be parsed");
+  }
+  let previous = "";
+  for (const point of points) {
+    if (!ISO_DATE.test(point.date)) throw new SourceError("DATA_SOURCE_CORRUPTED", "Canonical dataset contains an invalid date");
+    if (typeof point.value !== "number" || !Number.isFinite(point.value)) throw new SourceError("DATA_SOURCE_CORRUPTED", "Canonical dataset contains a non-finite value");
+    if (point.date <= previous) throw new SourceError("DATA_SOURCE_CORRUPTED", "Canonical dataset chronology is violated");
+    previous = point.date;
+  }
+  return { points, checksum: checksum(points.map((point) => `${point.date}\t${point.value}`).join("\n")) };
+}
+
+export async function readSnapshots(): Promise<ShadowSnapshot[]> {
+  try {
+    return await readJsonl<ShadowSnapshot>(shadowPaths().forecasts, isSnapshotRecord);
+  } catch {
+    throw new SourceError("DATA_SOURCE_CORRUPTED", "Shadow forecasts storage is corrupted");
+  }
+}
+export async function readReconciliations(): Promise<ReconciliationRecord[]> {
+  try {
+    return await readJsonl<ReconciliationRecord>(shadowPaths().reconciliations, isReconciliationRecord);
+  } catch {
+    throw new SourceError("DATA_SOURCE_CORRUPTED", "Shadow reconciliation storage is corrupted");
+  }
+}
+export async function readShadowErrors(): Promise<ShadowError[]> {
+  try {
+    return await readJsonl<ShadowError>(shadowPaths().errors, isShadowErrorRecord);
+  } catch {
+    throw new SourceError("DATA_SOURCE_CORRUPTED", "Shadow error storage is corrupted");
+  }
+}
+export async function readManifest(): Promise<ShadowManifest | null> {
+  try {
+    return JSON.parse(await readFile(shadowPaths().manifest, "utf8")) as ShadowManifest;
+  } catch {
+    return null;
+  }
+}
+export async function shadowFileChecksums(): Promise<Record<string, string>> {
+  const paths = shadowPaths();
+  const result: Record<string, string> = {};
+  for (const [name, path] of [["forecasts", paths.forecasts], ["reconciliations", paths.reconciliations], ["manifest", paths.manifest]] as const) {
+    try {
+      result[name] = checksum(await readFile(path, "utf8"));
+    } catch {
+      result[name] = "NOT_AVAILABLE";
+    }
+  }
+  return result;
+}
