  "sql_redacted": "{% set cafebakery_dict = {\"Кафе\": 1, \"Пекарня\": 2, \"Кафе и пекарня\": 3} %}\r\n{% set cafebakery_list = [] %}\r\n{% for element in filter_values(\"filter\") %}\r\n {% set _ = cafebakery_list.append(cafebakery_dict[element]) %}\r\n{% endfor %}\r\n\r\nSELECT \r\n dt.vv_week as vv_week,\r\n dt.shopno as shopno, \r\n dt.id_order as id_order, \r\n dt.order_type as order_type, \r\n dt.gettype as gettype, \r\n dt.pickup as pickup, \r\n dt.date_order as date_order, \r\n dt.date_supply as date_supply, \r\n dt.date_supply as date_supply_double,\r\n dt.sum_order as sum_order, \r\n dt.date_printed as date_printed, \r\n dt.date_status_10 as date_status_10, \r\n dt.date_f_status_3_5 as date_f_status_3_5, \r\n dt.date_set_cell as date_set_cell, \r\n dt.sum_paid as sum_paid, \r\n dt.sum_paid_disc as sum_paid_disc, \r\n dt.id_delivery_job as id_delivery_job, \r\n dt.id_partner as id_partner, \r\n dt.number as number, \r\n dt.id_service as id_service, \r\n dt.id_general as id_general, \r\n dt.user_code as user_code, \r\n dt.id_source as id_source, \r\n dt.date_check_closed as date_check_closed, \r\n dt.date_delivery_start as date_delivery_start, \r\n dt.date_delivered as date_delivered, \r\n dt.date_status as date_status, \r\n dt.id_courier as id_courier, \r\n dt.phone as phone, \r\n dt.id_pay_way as id_pay_way, \r\n dt.date_supply_untill as date_supply_untill, \r\n dt.weight_sheet as weight_sheet, \r\n dt.order_source as order_source, \r\n dt.order_service as order_service, \r\n dt.partner as partner, \r\n dt.pay_way as pay_way, \r\n dt.qty_ordered as qty_ordered, \r\n dt.delivery_type as delivery_type, \r\n dt.order_status as order_status, \r\n dt.date_collected_plan as date_collected_plan, \r\n dt.date_collect_start_plan as date_collect_start_plan, \r\n dt.order_time as order_time, \r\n dt.collection_time_all, \r\n dt.delivery_time_all as delivery_time_all, \r\n dt.wait_time as wait_time, \r\n dt.collection_time as collection_time, \r\n dt.pay_time as pay_time, \r\n dt.set_cell_time as set_cell_time, \r\n dt.wait_time2 as wait_time2, \r\n dt.delivery_time as delivery_time, \r\n dt.collection_time_real_sec as collection_time_real_sec, \r\n \r\n dictGetOrNull('dimension.dict_tt', 'name_tt', dt.shopno) as name_tt,\r\n dt.id_group as id_group, \r\n EXTRACT(HOUR FROM dt.date_supply) as hour_supply,\r\n dt.feature_tt as feature_tt, \r\n dt.region_tt as region_tt, \r\n dt.city_tt as city_tt,\r\n dt.area_tt as area_tt, \r\n dt.id_tt as id_tt, \r\n dt.dark as dark,\r\n dt.pom as pom_old, \r\n dt.geo as geo, \r\n dt.head_of_delivery as head_of_delivery, \r\n dt.leader as leader, \r\n dt.senior as senior, \r\n dt.leader_express as leader_express, \r\n dt.senior_express as senior_express, \r\n dt.delivery_type_group as delivery_type_group, \r\n dt.id_assemblysheet as id_assemblysheet, \r\n dt.partner_type as partner_type, \r\n dt.id_partner_type as id_partner_type, \r\n dt.night as night, \r\n dt.slots as slots, \r\n dt.qty_collected as qty_collected, \r\n dt.qty_collected_goods as qty_collected_goods, \r\n dt.qty_collected_services as qty_collected_services, \r\n dt.sum_mark as sum_mark, \r\n dt.collection_time_real_sec_sheet as collection_time_real_sec_sheet, \r\n dt.pse_no as pse_no, \r\n dt.pse as pse, \r\n dt.id_sbor as id_sbor, \r\n dt.courier as courier, \r\n dt.date_update as date_update, \r\n dt.date_collect_start as date_collect_start, \r\n dt.id_status as id_status, \r\n dt.id_pse_type as id_pse_type, \r\n dt.date_supply_untill - coalesce(dt.sla_delivery_time_all, 0) * 60 as deadline_sbor,\r\n coalesce(dt.date_set_cell, dt.date_f_status_3_5) as last_sbor_touch,\r\n \r\n dt.pse_type as pse_type, \r\n dt.date_supply_sheet as date_supply_sheet, \r\n dt.date_supply_untill_sheet as date_supply_untill_sheet, \r\n dt.date_collect_start_sheet as date_collect_start_sheet, \r\n dt.date_collected_sheet as date_collected_sheet, \r\n dt.is_cell_link as is_cell_link, \r\n dt.is_collected as is_collected, \r\n dt.is_out_of_mkad as is_out_of_mkad, \r\n dt.is_final_sheet as is_final_sheet, \r\n dt.is_in_dark_area as is_in_dark_area,\r\n dt.date_collected as date_collected,\r\n dt.sbor as sbor,\r\n dt.feature_sbor as feature_sbor,\r\n dt.id_user_kontr as id_user_kontr,\r\n dt.user_kontr as user_kontr,\r\n dt.user_inn as user_inn,\r\n dt.id_service_type as id_service_type,\r\n dt.service_type as service_type,\r\n dt.sort_sheet as sort_sheet,\r\n dt.sort_order as sort_order,\r\n dt.waiting_area_time as waiting_area_time,\r\n dt.sla_collection_time_all as sla_collection_time_all,\r\n dt.sla_delivery_time_all as sla_delivery_time_all,\r\n dt.sla_order_time as sla_order_time,\r\n dt.is_express as is_express,\r\n EXTRACT(HOUR FROM dt.date_supply) as supply_hour,\r\n dictGetOrNull('dimension.dict_pomoschniki', 'pom', dt.shopno) as pom_now,\r\n dictGetOrNull('dimension.dict_pomoschniki', 'pom', dt.shopno) as pom,\r\n CASE WHEN dt.id_partner = 164978 THEN 'Биостория' ELSE NULL END as sub_project,\r\n dt.final_sheet_type as final_sheet_type,\r\n dt.id_pool as id_pool,\r\n CAST(dt.date_supply_untill AS VARCHAR) as time_supply,\r\n CASE WHEN dt.pse_type = 'ДаркКитчен' then 'ДаркКитчен'\r\n WHEN dt.id_partner IN ( 24808,49598) then 'Ролл'\r\n WHEN dt.id_partner = 164978 then 'Биостория'\r\n \r\n \r\n \r\n \r\n \r\n \r\n \r\n \r\n \r\n \r\n \r\n \r\n \r\n \r\n \r\n \r\n \r\n END as dk_or_roll,\r\n dt.device_id as device_id,\r\n dt.device_type as device_type,\r\n dt.is_canceled as is_canceled, \r\n dt.is_returned_store as is_returned_store,\r\n dt.ose_no as ose_no,\r\n dt.user_position as user_position,\r\n dt.cafebakery_closed\r\n , dt.name_tt as \"Номер ТТ\"\r\n , dt.pom as \"Помощник розницы\"\r\n , dt.leader as \"Помощник мили\"\r\n , dt.head_of_delivery as \"Группа мили\"\r\n , dt.id_group as \"Группа розницы\"\r\n , dt.date_supply_untill - coalesce(dt.sla_delivery_time_all, 0) * 60 as deadline_sbor\r\n , coalesce(dt.date_set_cell, dt.date_f_status_3_5) as last_sbor_touch\r\n , dt.darkkitchen_closed as darkkitchen_closed\r\n , coalesce(nullIf(s.management_type, ''), ss.management_type) as management_type\r\n , coalesce(nullIf(s.online_manager, ''), ss.online_manager) as online_manager\r\n , coalesce(nullIf(s.assembly_leader, ''), ss.assembly_leader) as assembly_leader\r\n , coalesce(nullIf(s.delivery_leader, ''), ss.delivery_leader) as delivery_leader\r\n , n.kyst_name\r\n , C",
