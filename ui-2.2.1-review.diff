+/** UI-2: локальная оболочка DSS. Данные — только через HTTP API; fixtures не используются. */
+import {
+  appShell,
+  card,
+  chartCard,
+  completenessCalendar,
+  dataTable,
+  emptyState,
+  errorState,
+  formatDate,
+  formatNumber,
+  kpiGrid,
+  lineChart,
+  loadingState,
+  pageHeader,
+  provenanceDrawer,
+  sidebar,
+  statusBadge,
+  topbar,
+  trusted,
+  type TrustedHtml,
+} from "./components";
+import { api, ApiClientError, type ApiResult } from "./api/client";
+
+interface Overview {
+  shopNo: string;
+  timezone: string;
+  metric: string;
+  sliceId: number;
+  semantics: string;
+  history: { days: number; firstDate: string | null; lastDate: string | null; lastValue: number | null; checksum: string; fileChecksum: string; completeness: string };
+  provenance?: { normalizedChecksum: string; fileChecksum: string; manifestDatasetChecksum: string | null; manifestStatus: string; freshness: "MATCH" | "STALE" | "NOT_CONFIRMED" };
+  shadow: { snapshots: number; pending: number; reconciled: number; fallbacks: number; invalids: number; candidate: string; baseline: string; horizons: number[]; available: boolean };
+  replay: { snapshots: number; pending: number; reconciled: number; fallbacks: number; invalids: number; available: boolean };
+}
+interface History { points: Array<{ date: string; value: number }>; from: string | null; to: string | null; totalPoints: number; returnedPoints: number }
+interface ShadowForecasts { totals: { snapshots: number; pending: number; reconciled: number; fallbacks: number; invalids: number }; modeTotals: { shadow: { snapshots: number }; replay: { snapshots: number } }; errors: number; conflicts: number; items: Array<{ snapshotId: string; mode: string; modelId: string; horizon: number; originDate: string; targetDate: string; forecastValue: number | null; status: string }> }
+
+const root = document.getElementById("app")!;
+
+function stateBlock(result: ApiResult<unknown>, render: () => string): string {
+  if (result.status === "not_available") return emptyState({ title: "Данные недоступны", detail: `причина: ${result.meta.reason ?? "UNKNOWN"}` });
+  if (result.status === "error") return errorState({ title: "Ошибка источника", detail: result.error.message, code: result.error.code });
+  return render();
+}
+
+function shell(content: string, updatedAt: string | null, sourceStatus: "OK" | "PARTIAL" | "NOT_AVAILABLE"): string {
+  return appShell({
+    sidebar: sidebar({
+      brandName: "DSS",
+      brandSub: "прогнозирование заказов",
+      sections: [
+        { title: "Обзор", items: [{ href: "#overview", label: "Overview", current: true }] },
+        { title: "Данные", items: [{ href: "#history", label: "История" }, { href: "#shadow", label: "Теневой режим" }] },
+      ],
+    }),
+    topbar: topbar({ title: "DSS · панель прогнозирования", shopNo: "7745", lastUpdated: updatedAt, sourceStatus }),
+    content: trusted(content),
+  });
+}
+
+/** R9: независимая обработка ошибок разделов — падение одного не ломает остальные. */
+async function loadResult<T>(promise: Promise<ApiResult<T>>): Promise<ApiResult<T>> {
+  try {
+    return await promise;
+  } catch (error) {
+    const clientError = error as ApiClientError;
+    return { status: "error", error: { code: clientError.code ?? "UNKNOWN", message: clientError.message ?? "Неизвестная ошибка" } };
+  }
+}
+
+function shadowTable(data: ShadowForecasts, emptyText: string): TrustedHtml {
+  return dataTable({
+    columns: [{ key: "model", label: "Модель" }, { key: "horizon", label: "h", numeric: true }, { key: "origin", label: "origin" }, { key: "target", label: "target" }, { key: "value", label: "Прогноз", numeric: true }, { key: "status", label: "Статус" }],
+    rows: data.items.slice(-10).map((item) => ({ model: item.modelId, horizon: item.horizon, origin: formatDate(item.originDate), target: formatDate(item.targetDate), value: item.forecastValue === null ? "NOT_AVAILABLE" : formatNumber(item.forecastValue), status: item.status })),
+    emptyText,
+  });
+}
+
+async function render(): Promise<void> {
+  root.innerHTML = shell(loadingState({ rows: 6 }), null, "NOT_AVAILABLE");
+  const [overview, history, shadowOnly, replayOnly] = await Promise.all([
+    loadResult(api.get<Overview>("/api/v1/overview")),
+    loadResult(api.get<History>("/api/v1/history", { limit: 120 })),
+    loadResult(api.get<ShadowForecasts>("/api/v1/shadow/forecasts", { limit: 40 })),
+    loadResult(api.get<ShadowForecasts>("/api/v1/shadow/forecasts", { mode: "replay", limit: 20 })),
+  ]);
+
+  const overviewBlock = stateBlock(overview, () => {
+    const data = (overview as { data: Overview }).data;
+    const freshness = data.provenance?.freshness ?? "NOT_CONFIRMED";
+    const freshnessStatus = freshness === "MATCH" ? "OK" : freshness === "STALE" ? "CONFLICT" : "NOT_AVAILABLE";
+    return `
+${pageHeader({ title: "Обзор", subtitle: `магазин ${data.shopNo} · ${data.timezone} · метрика ${data.metric} · slice ${data.sliceId}`, right: statusBadge({ status: "PROVISIONAL" }) })}
+<div class="ds-grid ds-grid--cards">
+  ${card({ title: "История", body: kpiGrid([
+    { label: "Дней", value: formatNumber(data.history.days), note: `${formatDate(data.history.firstDate)} — ${formatDate(data.history.lastDate)}`, status: data.history.completeness === "COMPLETE" ? "OK" : "PENDING" },
+    { label: "Последний факт", value: formatNumber(data.history.lastValue), note: formatDate(data.history.lastDate), status: "OK" },
+  ]) })}
+  ${card({ title: "Теневой режим", body: kpiGrid([
+    { label: "Shadow-снапшотов", value: formatNumber(data.shadow.snapshots), note: `replay отдельно: ${data.replay?.snapshots ?? "NOT_AVAILABLE"}`, status: data.shadow.available ? "OK" : "NOT_AVAILABLE" },
+    { label: "Ожидают факта", value: formatNumber(data.shadow.pending), note: `сверено ${data.shadow.reconciled}`, status: "PENDING" },
+  ]) })}
+</div>
+${card({ title: "Происхождение и актуальность", body: trusted(`
+  <div class="ds-row">${statusBadge({ status: freshnessStatus, text: `соответствие manifest: ${freshness}` })}${statusBadge({ status: "PROVISIONAL" })}</div>
+  ${provenanceDrawer({ source: "canonical CSV (read-only)", checksum: `file ${data.provenance?.fileChecksum ?? "NOT_AVAILABLE"}`, version: `normalized ${data.provenance?.normalizedChecksum ?? "NOT_AVAILABLE"}`, note: `manifest: ${data.provenance?.manifestStatus ?? "NOT_AVAILABLE"} · ${data.provenance?.manifestDatasetChecksum ?? "NOT_AVAILABLE"}` })}`) })}
+`;
+  });
+
+  const historyBlock = stateBlock(history, () => {
+    const data = (history as { data: History }).data;
+    const chart = lineChart([{ name: "actual", className: "actual", points: data.points.map((point) => ({ date: point.date, value: point.value })) }]);
+    const calendar = completenessCalendar(data.points.slice(-28).map((point) => ({ date: point.date, status: Number.isFinite(point.value) ? "full" as const : "missing" as const })));
+    return `
+${card({ title: "История фактов", subtitle: `показано ${data.returnedPoints} из ${data.totalPoints} наблюдений`, body: chart })}
+<div class="ds-grid ds-grid--middle">
+  ${card({ title: "Полнота (последние 28 дней)", body: calendar })}
+  ${card({ title: "Таблица", body: dataTable({ columns: [{ key: "date", label: "Дата" }, { key: "value", label: "Заказы", numeric: true }], rows: data.points.slice(-12).map((point) => ({ date: formatDate(point.date), value: formatNumber(point.value) })) }) })}
+</div>`;
+  });
+
+  const shadowBlock = stateBlock(shadowOnly, () => {
+    const data = (shadowOnly as { data: ShadowForecasts }).data;
+    return `
+${card({ title: "Теневой режим: реальные наблюдения", subtitle: "только mode=shadow — реальные прогнозы, ожидающие факта или сверенные", body: shadowTable(data, "Реальных shadow-прогнозов пока нет") })}
+${card({ title: "Сводка теневого режима", body: kpiGrid([
+      { label: "Снапшотов (shadow)", value: formatNumber(data.totals.snapshots), status: "OK" },
+      { label: "Сверено", value: formatNumber(data.totals.reconciled), status: "OK" },
+      { label: "Ожидают", value: formatNumber(data.totals.pending), status: "PENDING" },
+      { label: "Ошибки", value: formatNumber(data.errors), status: data.errors ? "CONFLICT" : "OK" },
+    ]) })}`;
+  });
+
+  const replayBlock = stateBlock(replayOnly, () => {
+    const data = (replayOnly as { data: ShadowForecasts }).data;
+    return card({
+      title: "Историческая диагностика (replay)",
+      subtitle: "historical replay — воспроизведение на прошлых периодах; НЕ доказательство работы реального теневого режима",
+      right: statusBadge({ status: "NOT_AVAILABLE", text: "историческая диагностика" }),
+      body: shadowTable(data, "Исторических replay-записей нет"),
+    });
+  });
+
+  const sourceStatus = overview.status === "ok" ? "OK" : overview.status === "not_available" ? "NOT_AVAILABLE" : "PARTIAL";
+  const updatedAt = overview.status === "ok" ? overview.meta.generatedAt : null;
+  root.innerHTML = shell(`${overviewBlock}${historyBlock}${shadowBlock}${replayBlock}`, updatedAt, sourceStatus);
+}
+
+document.querySelector("[data-ds-menu]")?.addEventListener("click", () => {
+  document.querySelector("[data-ds-sidebar]")?.classList.toggle("is-open");
+});
+void render();
