{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dds.local/schemas/events/TRIP_DEPARTED.schema.json",
  "title": "TRIP_DEPARTED",
  "allOf": [
    {
      "$ref": "../event-envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "event_type": {
      "const": "TRIP_DEPARTED"
    },
    "payload": {
      "type": "object",
      "required": [
        "trip_id",
        "departed_at"
      ],
      "properties": {
        "trip_id": {
          "type": [
            "string",
            "number",
            "array",
            "null"
          ]
        },
        "departed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}