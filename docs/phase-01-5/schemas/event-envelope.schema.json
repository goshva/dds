{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dds.local/schemas/event-envelope.schema.json",
  "title": "Domain event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "recorded_at",
    "idempotency_key",
    "schema_version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "minLength": 3
    },
    "aggregate_type": {
      "type": "string",
      "minLength": 1
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "actor_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_system": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 3
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  }
}